---
// WordCounter Tool Component — pure vanilla JS, no dependencies
---

<section class="tool-section" aria-label="Word counter tool">
  <div class="stats-bar" role="status" aria-live="polite" aria-atomic="true">
    <div class="stat-item"><span class="stat-value" id="stat-words">0</span><span class="stat-label">Words</span></div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item"><span class="stat-value" id="stat-chars">0</span><span class="stat-label">Characters</span></div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item"><span class="stat-value" id="stat-chars-no-space">0</span><span class="stat-label">No spaces</span></div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item"><span class="stat-value" id="stat-sentences">0</span><span class="stat-label">Sentences</span></div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item"><span class="stat-value" id="stat-paragraphs">0</span><span class="stat-label">Paragraphs</span></div>
    <div class="stat-divider" aria-hidden="true"></div>
    <div class="stat-item"><span class="stat-value" id="stat-reading">0 min</span><span class="stat-label">Read time</span></div>
  </div>
  <div class="textarea-wrap">
    <textarea id="word-counter-input" class="counter-textarea" placeholder="Start typing or paste your text here…" aria-label="Text input for word counting" spellcheck="true" autofocus></textarea>
  </div>
  <div class="toolbar" role="toolbar" aria-label="Text transformation tools">
    <div class="toolbar-group">
      <button class="tool-btn" id="btn-uppercase">UPPERCASE</button>
      <button class="tool-btn" id="btn-lowercase">lowercase</button>
      <button class="tool-btn" id="btn-titlecase">Title Case</button>
      <button class="tool-btn" id="btn-sentencecase">Sentence case</button>
      <button class="tool-btn" id="btn-remove-extra-spaces">Clean spaces</button>
    </div>
    <div class="toolbar-right">
      <button class="tool-btn tool-btn-copy" id="btn-copy"><span id="copy-label">Copy</span></button>
      <button class="tool-btn tool-btn-clear" id="btn-clear">Clear</button>
    </div>
  </div>
</section>

<style>
  .tool-section { background-color: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); overflow: hidden; transition: background-color var(--transition), border-color var(--transition); }
  .stats-bar { display: flex; align-items: stretch; flex-wrap: wrap; border-bottom: 1px solid var(--border); background-color: color-mix(in srgb, var(--bg-page) 40%, var(--bg-surface)); transition: background-color var(--transition), border-color var(--transition); }
  .stat-item { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0.75rem 1.25rem; gap: 0.125rem; flex: 1; min-width: 80px; }
  .stat-value { font-size: var(--text-2xl); font-weight: 700; color: var(--color-green); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .stat-label { font-size: 11px; font-weight: 500; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }
  .stat-divider { width: 1px; background-color: var(--border); margin: 0.5rem 0; align-self: stretch; flex-shrink: 0; }
  .textarea-wrap { position: relative; }
  .counter-textarea { width: 100%; min-height: 260px; padding: 1.25rem; font-size: var(--text-base); font-family: inherit; line-height: 1.7; color: var(--text-primary); background-color: var(--bg-surface); border: none; resize: vertical; outline: none; transition: background-color var(--transition), color var(--transition); }
  .counter-textarea::placeholder { color: var(--text-muted); }
  .counter-textarea:focus { box-shadow: inset 0 0 0 2px var(--accent); border-radius: 0; }
  .toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.375rem; padding: 0.75rem 1rem; border-top: 1px solid var(--border); background-color: color-mix(in srgb, var(--bg-page) 40%, var(--bg-surface)); transition: background-color var(--transition), border-color var(--transition); }
  .toolbar-group { display: flex; align-items: center; flex-wrap: wrap; gap: 0.375rem; flex: 1; }
  .toolbar-right { display: flex; align-items: center; gap: 0.375rem; flex-shrink: 0; }
  .tool-btn { display: inline-flex; align-items: center; gap: 0.3rem; padding: 6px 0.75rem; font-size: var(--text-sm); font-weight: 500; color: var(--text-secondary); background-color: transparent; border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; transition: all var(--transition-fast); white-space: nowrap; }
  .tool-btn:hover { border-color: var(--accent); color: var(--accent); background-color: color-mix(in srgb, var(--accent) 6%, transparent); }
  .tool-btn:active { transform: scale(0.97); }
  .tool-btn-copy.copied { border-color: var(--color-green); color: var(--color-green); background-color: color-mix(in srgb, var(--color-green) 8%, transparent); }
  .tool-btn-clear:hover { border-color: #ff4953; color: #ff4953; background-color: color-mix(in srgb, #ff4953 6%, transparent); }
  @media (max-width: 480px) {
    .stat-divider { display: none; }
    .stat-item { padding: 0.625rem 0.75rem; min-width: 70px; }
    .stat-value { font-size: var(--text-xl); }
    .counter-textarea { min-height: 200px; }
    .tool-btn { font-size: 12px; padding: 5px 0.5rem; }
  }
</style>

<script>
  const textarea = document.getElementById('word-counter-input') as HTMLTextAreaElement;
  function countWords(text: string): number { const t = text.trim(); if (!t) return 0; return t.split(/\s+/).filter(w => w.length > 0).length; }
  function countSentences(text: string): number { const t = text.trim(); if (!t) return 0; const m = t.match(/[^.!?]*[.!?]+/g); return m ? m.filter(s => s.trim().length > 0).length : (t.length > 0 ? 1 : 0); }
  function countParagraphs(text: string): number { const t = text.trim(); if (!t) return 0; return t.split(/\n\s*\n/).filter(p => p.trim().length > 0).length; }
  function readingTime(words: number): string { const m = Math.ceil(words / 200); if (m < 1) return '< 1 min'; return m === 1 ? '1 min' : `${m} min`; }
  function updateStats() {
    const text = textarea.value;
    const words = countWords(text);
    (document.getElementById('stat-words') as HTMLElement).textContent = words.toLocaleString();
    (document.getElementById('stat-chars') as HTMLElement).textContent = text.length.toLocaleString();
    (document.getElementById('stat-chars-no-space') as HTMLElement).textContent = text.replace(/\s/g, '').length.toLocaleString();
    (document.getElementById('stat-sentences') as HTMLElement).textContent = countSentences(text).toLocaleString();
    (document.getElementById('stat-paragraphs') as HTMLElement).textContent = countParagraphs(text).toLocaleString();
    (document.getElementById('stat-reading') as HTMLElement).textContent = readingTime(words);
  }
  textarea?.addEventListener('input', updateStats);
  function toTitleCase(str: string): string {
    const minor = new Set(['a','an','the','and','but','or','for','nor','on','at','to','by','in','of','up','as','is','it']);
    return str.toLowerCase().split(/(\s+)/).map((w, i) => { if (/^\s+$/.test(w)) return w; if (i === 0 || !minor.has(w)) return w.charAt(0).toUpperCase() + w.slice(1); return w; }).join('');
  }
  function toSentenceCase(str: string): string { return str.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, c => c.toUpperCase()); }
  document.getElementById('btn-uppercase')?.addEventListener('click', () => { textarea.value = textarea.value.toUpperCase(); updateStats(); });
  document.getElementById('btn-lowercase')?.addEventListener('click', () => { textarea.value = textarea.value.toLowerCase(); updateStats(); });
  document.getElementById('btn-titlecase')?.addEventListener('click', () => { textarea.value = toTitleCase(textarea.value); updateStats(); });
  document.getElementById('btn-sentencecase')?.addEventListener('click', () => { textarea.value = toSentenceCase(textarea.value); updateStats(); });
  document.getElementById('btn-remove-extra-spaces')?.addEventListener('click', () => { textarea.value = textarea.value.split('\n').map(l => l.replace(/\s+/g, ' ').trim()).join('\n').replace(/\n{3,}/g, '\n\n'); updateStats(); });
  document.getElementById('btn-copy')?.addEventListener('click', async () => {
    if (!textarea.value) return;
    try {
      await navigator.clipboard.writeText(textarea.value);
      const btn = document.getElementById('btn-copy'); const label = document.getElementById('copy-label');
      if (btn && label) { btn.classList.add('copied'); label.textContent = 'Copied!'; setTimeout(() => { btn.classList.remove('copied'); label.textContent = 'Copy'; }, 2000); }
    } catch { textarea.select(); document.execCommand('copy'); }
  });
  document.getElementById('btn-clear')?.addEventListener('click', () => { textarea.value = ''; updateStats(); textarea.focus(); });
</script>
